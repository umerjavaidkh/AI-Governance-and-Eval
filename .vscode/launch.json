{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Update collection (offline smoke test)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/update_collection.py",
      "args": ["--skip-discovery", "--skip-refresh"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Update collection (full run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/update_collection.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
