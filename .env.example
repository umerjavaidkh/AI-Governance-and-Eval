# Copy to .env for local runs:  cp .env.example .env
# .env is gitignored — never commit real tokens.

# Optional locally, but avoids GitHub's anonymous rate limit
# (60 core requests/hour, 10 searches/minute). Needs no scopes for public repos.
GITHUB_TOKEN=

# Optional. Enables the 🏆 Category Leaders spotlight blurbs for entries with no
# hand-written `best_for` line. Without a key the agent skips spotlights silently.
OPENAI_API_KEY=

# Alternative to OPENAI_API_KEY — also set `spotlights.provider: anthropic` in config.yaml.
ANTHROPIC_API_KEY=
